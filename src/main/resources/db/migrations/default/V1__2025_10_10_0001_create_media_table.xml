<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Create Client Table -->
    <changeSet id="enable-uuid-ossp" author="KOGHENE">
        <sql>CREATE EXTENSION IF NOT EXISTS "uuid-ossp";</sql>
    </changeSet>

    <changeSet id="create-update-timestamp-function" author="KOGHENE">
        <comment>Creates a function to automatically update the updated_at timestamp on row modification</comment>
        <sql splitStatements="false" endDelimiter="$$" stripComments="false">
            CREATE OR REPLACE FUNCTION update_timestamp_column()
            RETURNS TRIGGER AS $$
            BEGIN
               NEW.updated_at = now();
            RETURN NEW;
            END;
            $$ language 'plpgsql';
        </sql>
    </changeSet>
    <changeSet id="create-media-table" author="Etougue">
        <createTable tableName="media">
            <!-- Client ID -->
            <column name="id" type="UUID"
                    defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="service" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="real_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="size" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="mime" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="extension" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="path" type="VARCHAR(1024)">
                <constraints nullable="false"/>
            </column>

            <column name="uri" type="VARCHAR(1024)">
                <constraints nullable="false"/>
            </column>

            <!-- Audit fields -->
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_by" type="UUID"/>
            <column name="updated_by" type="UUID"/>
            <column name="deleted_by" type="UUID"/>
        </createTable>

        <createIndex indexName="idx_media_name"
                     tableName="media">
            <column name="name"/>
        </createIndex>

        <createIndex indexName="idx_media_path"
                     tableName="media">
            <column name="path"/>
        </createIndex>
    </changeSet>
    <changeSet id="attach-update-trigger-to-media" author="KOGHENE">
        <comment>Attach the timestamp update trigger to the media table</comment>
        <sql>
            CREATE TRIGGER update_media_timestamp
                BEFORE UPDATE ON media
                FOR EACH ROW
                EXECUTE FUNCTION update_timestamp_column();
        </sql>
    </changeSet>


</databaseChangeLog>
