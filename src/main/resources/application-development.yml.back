server:
  port: 8081

spring:
  application:
    name: media-service
  r2dbc:
    url: r2dbc:postgresql://localhost:5432/media_db
    username: postgres
    password: password
    pool:
      enabled: true
  security:
    oauth2:
      resourceserver:
        jwt:
          jwk-set-uri: "http://localhost:8088/realms/your-realm/protocol/openid-connect/certs"

minio:
  endpoint: http://127.0.0.1:9000
  access-key: minioadmin
  secret-key: minioadmin
  bucket: media

management:
  endpoints:
    web:
      exposure:
        include: "health,prometheus"

logging:
  level:
    root: INFO
    org.springframework.security: DEBUG
    org.springframework.web.reactive: DEBUG
    org.springframework.r2dbc: DEBUG